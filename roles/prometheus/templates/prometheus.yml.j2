global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - "localhost:9090"

  - job_name: node
    static_configs:
{% for host in groups['node_exporters'] %}
      - targets:
          - "{{ hostvars[host].ansible_host }}:9100"
        labels:
          instance: "{{ host }}"
{% endfor %}

  - job_name: cadvisor
    static_configs:
{% for host in groups['docker'] %}
      - targets:
          - "{{ hostvars[host].ansible_host }}:18080"
        labels:
          instance: "{{ host }}"
{% endfor %}

  - job_name: traefik
    static_configs:
      - targets:
          - "10.35.10.10:8082"
        labels:
          instance: "vm-proxy-01"