#------------------------------------------------------------------------------
# SYSTEM NAV
#------------------------------------------------------------------------------

alias ..='cd ..'  
alias ...='cd ../..'  
alias .3='cd ../../..'  
alias .4='cd ../../../..'  
alias .5='cd ../../../../..'  

#------------------------------------------------------------------------------
# LS / FILES
#------------------------------------------------------------------------------

alias ls='ls -F --color=auto --group-directories-first'  
alias ll='ls -alh --color=auto --group-directories-first'  
alias lt='ls --human-readable --size -1 -S --classify'  
alias lsr='ls -t -1'

alias mkdir='mkdir -pv'  
alias cp='cp -iv'  
alias mv='mv -iv'

#------------------------------------------------------------------------------
# DISK / USAGE
#------------------------------------------------------------------------------

alias space='du -sh * | sort -hr'  
alias disks='lsblk -o NAME,SIZE,TYPE,MOUNTPOINT'  
alias diskusage='df -hl --total | grep total'

#------------------------------------------------------------------------------
# PROCESS / PERF
#------------------------------------------------------------------------------

alias psmem10='ps auxf | sort -nr -k 4 | head -10'  
alias pscpu10='ps auxf | sort -nr -k 3 | head -10'  
alias meminfo='free -h'

#------------------------------------------------------------------------------
# NETWORK
#------------------------------------------------------------------------------

alias ports='netstat -tulanp'  
alias myip='curl -s ifconfig.me'  
alias localip='hostname -I | awk "{print $1}"'

#------------------------------------------------------------------------------
# SYSTEMCTL
#------------------------------------------------------------------------------

alias ctlstart='sudo systemctl start'  
alias ctlstop='sudo systemctl stop'  
alias ctlrestart='sudo systemctl restart'  
alias ctlstatus='sudo systemctl status'

#------------------------------------------------------------------------------
# PACKAGE MANAGEMENT
#------------------------------------------------------------------------------

# APT Package Management
alias update='sudo apt update'      # Update package index
alias upgrade='sudo apt update && sudo apt full-upgrade'      # Update package index and upgrade all packages

#------------------------------------------------------------------------------
# FILE COMPRESSION
#------------------------------------------------------------------------------

# Archive Management
alias untargz='tar --same-owner -zxvf'      # Extract .tar.gz archive preserving ownership
alias untarbz='tar --same-owner -xjvf'      # Extract .tar.bz2 archive preserving ownership
alias lstargz='tar -ztvf'      # List contents of .tar.gz archive
alias lstarbz='tar -jtvf'      # List contents of .tar.bz2 archive
alias targz='tar -zcvf'      # Create .tar.gz archive
alias tarbz='tar -cjvf'      # Create .tar.bz2 archive

