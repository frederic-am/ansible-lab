#------------------------------------------------------------------------------
# DOCKER (MODERN - via dc)
#------------------------------------------------------------------------------

# Global

alias dcall='dc-all'  
alias dcupdate='dc-update-all'  
alias dchard='dc-hard-restart'

# Per project

_dc_check() {
if [[ -z "$1" ]]; then
echo "Usage: "
return 1
fi

_dc_autocomplete() {
    local cur prev projects

    cur="${COMP_WORDS[COMP_CWORD]}"

    projects=$(find /srv/docker -maxdepth 2 -name docker-compose.yml \
        | sed 's|/docker-compose.yml||' \
        | sed 's|/srv/docker/||')

    COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
}

complete -F _dc_autocomplete dc

local compose_file="/srv/docker/$1/docker-compose.yml"

if [[ ! -f "$compose_file" ]]; then
    echo "Error: project '$1' not found ($compose_file)"
    return 1
fi

}

dcup() {
_dc_check "$1" || return
dc "$1" up -d
}

dcdown() {
_dc_check "$1" || return
dc "$1" down --remove-orphans
}

dcstop() {
_dc_check "$1" || return
dc "$1" stop
}

dcstart() {
_dc_check "$1" || return
dc "$1" start
}

dcrestart() {
_dc_check "$1" || return
dc "$1" restart
}

dclogs() {
_dc_check "$1" || return
dc "$1" logs -tf --tail=50
}

dcpull() {
_dc_check "$1" || return
dc "$1" pull
}

#------------------------------------------------------------------------------
# DOCKER (LOW LEVEL)
#------------------------------------------------------------------------------

alias dps='sudo docker ps -a'  
alias dpss='sudo docker ps -a --format "table {{.Names}}\t{{.State}}\t{{.Status}}\t{{.Image}}" | (sed -u 1q; sort)'  
alias ddf='sudo docker system df'  
alias dexec='sudo docker exec -ti'

alias dlogs='sudo docker logs -tf --tail=50'  
alias dstop='sudo docker stop'  
alias dstopall='sudo docker ps -aq | xargs -r sudo docker stop'
alias drm='sudo docker ps -aq | xargs -r sudo docker rm'

alias dsvprune="docker system prune -f --volumes"

alias dprunevol='sudo docker volume prune'  
alias dprunesys='sudo docker system prune -a'  
alias ddelimages='sudo docker rmi $(sudo docker images -q)'

# FIXED (quote)

dlogsize() {
    sudo docker ps -q \
    | xargs -r sudo docker inspect --format='{{.Name}} {{.LogPath}}' \
    | while read name path; do
        size=$(sudo du -h "$path" 2>/dev/null | cut -f1)
        echo "$size $name"
    done | sort -h
}

